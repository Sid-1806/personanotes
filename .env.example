# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=personanotes
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Security
SECRET_KEY=YOUR_SUPER_SECRET_KEY_HERE_CHANGE_IN_PRODUCTION
ALGORITHM=HS256
# A study session outlasts 30 minutes. A token that expires mid-edit used to
# bounce the user to a login page and discard whatever was in the editor.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="Personalized AI Notes Generator"

# Vector DB (for future use)
QDRANT_URL=http://localhost:6333

# Optional: Redis powers response caching + per-user rate limiting. Without it
# both fall back to an in-process backend, so the app still runs.
# REDIS_URL=redis://localhost:6379/0

# OCR for scanned PDFs and photos, via Gemini multimodal.
OCR_ENABLED=true

GEMINI_MODEL=gemini-3.6-flash
